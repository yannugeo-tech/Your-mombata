-- Load Modules
local PlayerScripts = LocalPlayer.PlayerScripts
local GunModule = require(PlayerScripts.Modules.ItemTypes.Gun)
local Utility = require(ReplicatedStorage.Modules.Utility)

local CharacterParts = setmetatable({}, {
    __index = function(_, PartName)
        local Char = LocalPlayer.Character
        if not Char then return nil end
        if PartName == "root" then return Char:FindFirstChild("HumanoidRootPart")
        elseif PartName == "head" then return Char:FindFirstChild("Head") end
        return nil
    end
})

-- Ragebot Core Module
Env.RageModule = {}
do
    local Module = Env.RageModule

    function Module:Init()  
        self.Active = false
        self.Target = nil  
        self.Desync = false  
        self.HeartbeatConn = nil  
        self.DesyncConn = nil  
        self.ShootTask = nil  
        self.OriginalStartShooting = nil  
        self:Setup()  
    end  

    function Module:Setup()  
        self.HeartbeatConn = RunService.Heartbeat:Connect(function()  
            if not self.Active then return end  
            self.Target = self:FindTarget()  
        end)  

        local Original = GunModule.StartShooting  
        self.OriginalStartShooting = Original  

        GunModule.StartShooting = function(GunInstance, ...)  
            local Results = {Original(GunInstance, ...)}  

            if not GunInstance.ClientFighter or not GunInstance.ClientFighter.IsLocalPlayer then  
                return unpack(Results)  
            end  

            local ShootData = Results[3]  
            if not ShootData or typeof(ShootData) ~= "table" then  
                return unpack(Results)  
            end  

            Results[4] = true  
            local Target = self.Target  

            if not self.Active or not Target or not Target.Character then  
                return unpack(Results)  
            end  

            if not self.Desync or self.CurrentTarget ~= Target then  
                self:StartDesync(Target)  
                task.wait(0.1)  
            end  

            if self.ShootTask then  
                task.cancel(self.ShootTask)  
                self.ShootTask = nil  
            end  

            local TargetHead = Target.Character:FindFirstChild("Head")  
            if not TargetHead then return unpack(Results) end  

            local HeadPos = TargetHead.Position  
            local HeadCF = TargetHead.CFrame  
            local BelowPos = HeadPos - Vector3.new(0, 5, 0)  
            local LookCF = CFrame.lookAt(BelowPos, HeadPos)  
            local RandomOffset = HeadCF:ToObjectSpace(CFrame.new(HeadPos + Vector3.new(math.random(), math.random(), math.random())))  

            ShootData[utf8.char(0)] = Utility:EncodeCFrame(CFrame.new(BelowPos, HeadPos) * CFrame.Angles(LookCF:ToOrientation()))  
            ShootData[utf8.char(1)] = Utility:EncodeCFrame(CFrame.new(HeadPos) * CFrame.Angles(LookCF:ToOrientation()))  
            ShootData[utf8.char(2)] = TargetHead  
            ShootData[utf8.char(3)] = Utility:EncodeCFrame(RandomOffset)  

            self.ShootTask = task.delay(0.15, function()  
                self:StopDesync()  
            end)  

            return unpack(Results)  
        end  
    end  

    function Module:FindTarget()  
        local MyChar = LocalPlayer.Character  
        if not MyChar then return nil end  
        local MyRoot = MyChar:FindFirstChild("HumanoidRootPart")  
        if not MyRoot then return nil end  

        local Closest = nil  
        local ClosestDist = math.huge  
        local MAX_DISTANCE = 999999999999  

        for _, Player in next, Players:GetPlayers() do  
            if Player == LocalPlayer then continue end  
            if Player:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end  

            local Char = Player.Character  
            if not Char then continue end  

            local Root = Char:FindFirstChild("HumanoidRootPart")  
            local Head = Char:FindFirstChild("Head")  
            local Hum = Char:FindFirstChildWhichIsA("Humanoid")  

            if not (Root and Head and Hum and Hum.Health > 0) then continue end  

            local Dist = (MyRoot.Position - Root.Position).Magnitude  
            if Dist > MAX_DISTANCE then continue end  

            if Dist < ClosestDist then  
                ClosestDist = Dist  
                Closest = Player  
            end  
        end  

        return Closest  
    end  

    function Module:StartDesync(Target)  
        if self.DesyncConn then self.DesyncConn:Disconnect() end  
        self.Desync = true  
        self.CurrentTarget = Target  

        self.DesyncConn = RunService.Heartbeat:Connect(function()  
            if not self.Desync then return end  
            local MyRoot = CharacterParts.root  
            if not MyRoot then return end  

            local TargetRoot = Target.Character and Target.Character:FindFirstChild("HumanoidRootPart")  
            if not TargetRoot then  
                self:StopDesync()  
                return  
            end  

            local SavedCF = MyRoot.CFrame  
            local SavedVel = MyRoot.Velocity  
            local SavedRotVel = MyRoot.RotVelocity  

            MyRoot.CFrame = TargetRoot.CFrame * CFrame.new(0, -5, 0)  

            RunService:BindToRenderStep("DesyncRestore", 101, function()  
                MyRoot.CFrame = SavedCF  
                MyRoot.Velocity = SavedVel  
                MyRoot.RotVelocity = SavedRotVel  
                RunService:UnbindFromRenderStep("DesyncRestore")  
            end)  
        end)  
    end  

    function Module:StopDesync()  
        self.Desync = false  
        self.CurrentTarget = nil  
        if self.DesyncConn then  
            self.DesyncConn:Disconnect()  
            self.DesyncConn = nil  
        end  
    end  

    function Module:Shutdown()  
        self.Active = false  
        if self.HeartbeatConn then self.HeartbeatConn:Disconnect() end  
        if self.DesyncConn then self.DesyncConn:Disconnect() end  
        if self.ShootTask then task.cancel(self.ShootTask) end  
        if self.OriginalStartShooting then  
            GunModule.StartShooting = self.OriginalStartShooting  
        end  
    end  

    Module:Init()
end

