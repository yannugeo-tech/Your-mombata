local function ClearContent()
	for _, v in ipairs(Content:GetChildren()) do
		v:Destroy()
	end
end

local function Toggle(parent, text, y, callback)
	local Label = Instance.new("TextButton")
	Label.Text = text
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 28
	Label.TextColor3 = Color3.new(1,1,1)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.BackgroundTransparency = 1
	Label.Position = UDim2.new(0, 0, 0, y)
	Label.Size = UDim2.new(0.8, 0, 0, 55)
	Label.Parent = parent

	local Circle = Instance.new("TextButton")
	Circle.Text = ""
	Circle.AutoButtonColor = false
	Circle.BackgroundColor3 = Color3.fromRGB(245,245,245)
	Circle.Position = UDim2.new(0, 280, 0, y + 8)
	Circle.Size = UDim2.fromOffset(28,28)
	Circle.Parent = parent

	local Round = Instance.new("UICorner")
	Round.CornerRadius = UDim.new(1,0)
	Round.Parent = Circle

	local Enabled = false

	local function Set(value)
		Enabled = value

		if Enabled then
			Circle.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
		else
			Circle.BackgroundColor3 = Color3.fromRGB(245,245,245)
		end

		if callback then
			callback(Enabled)
		end
	end

	Circle.Activated:Connect(function()
		Set(not Enabled)
	end)

	Label.Activated:Connect(function()
		Set(not Enabled)
	end)

	return Set
end

local function ShowRage()
	ClearContent()

	Toggle(Content, "ragebot", 30, function(enabled)
		-- 네 게임 내부의 테스트용 Rage 기능을 여기에 연결
		print("Ragebot:", enabled)
	end)

	Toggle(Content, "rage", 100, function(enabled)
		print("Rage:", enabled)
	end)
end

